{
  "name": "overflow-audit",
  "version": "0.1.0",
  "description": "Fail CI when a page scrolls sideways on a phone. Visits each URL at mobile widths with Playwright and names the elements that stick out.",
  "type": "module",
  "license": "MIT",
  "author": "John Ennis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/John-E5/overflow-audit.git"
  },
  "homepage": "https://github.com/John-E5/overflow-audit#readme",
  "bugs": {
    "url": "https://github.com/John-E5/overflow-audit/issues"
  },
  "keywords": [
    "overflow",
    "horizontal-scroll",
    "mobile",
    "responsive",
    "layout",
    "css",
    "playwright",
    "testing",
    "github-action",
    "ci"
  ],
  "bin": {
    "overflow-audit": "dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
